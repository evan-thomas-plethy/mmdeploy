{
    "version": "1.3.1",
    "codebase": {
        "task": "ObjectDetection",
        "codebase": "mmdet",
        "version": "3.3.0",
        "pth": "mmdet/checkpoints/rtmdet-nano_heel_slides.pth",
        "config": "mmdet/configs/rtmdet_nano_320_8xb32_coco_finetune.py"
    },
    "codebase_config": {
        "type": "mmdet",
        "task": "ObjectDetection",
        "model_type": "end2end",
        "post_processing": {
            "score_threshold": 0.05,
            "confidence_threshold": 0.005,
            "iou_threshold": 0.5,
            "max_output_boxes_per_class": 200,
            "pre_top_k": 5000,
            "keep_top_k": 100,
            "background_label_id": -1
        }
    },
    "onnx_config": {
        "type": "torchscript",
        "save_file": "end2end.pt",
        "input_names": [
            "input"
        ],
        "output_names": [
            "dets",
            "labels"
        ],
        "input_shape": [
            320,
            320
        ]
    },
    "backend_config": {
        "type": "coreml",
        "convert_to": "neuralnetwork",
        "model_inputs": [
            {
                "input_shapes": {
                    "input": {
                        "min_shape": [
                            1,
                            3,
                            320,
                            320
                        ],
                        "max_shape": [
                            1,
                            3,
                            320,
                            320
                        ],
                        "default_shape": [
                            1,
                            3,
                            320,
                            320
                        ]
                    }
                }
            }
        ]
    },
    "calib_config": {}
}